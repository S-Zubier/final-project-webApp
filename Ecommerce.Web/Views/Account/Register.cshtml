@model Ecommerce.Domain.Entities.User
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="admin-card">
                <h2 class="admin-card-header text-center">تسجيل حساب جديد</h2>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center">@ViewBag.Error</div>
                }

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">User Name</label>
                        <input asp-for="Name" type="text" id="username" name="username" class="form-control custom-input" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Password</label>
                        <div style="position: relative;">
                            <input asp-for="Password" type="password" id="passwordInput" name="password" class="form-control custom-input" style="padding-left: 45px;" required />

                            <button type="button" onclick="togglePassword()" style="position: absolute; top: 50%; left: 12px; transform: translateY(-50%); background: none; border: none; color: #64748b; cursor: pointer; z-index: 10;">
                                <!-- 1. أيقونة العين العادية (تظهر افتراضياً) -->
                                <svg id="eyeIcon" xmlns="http://w3.org" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                </svg>

                                <!-- 2. أيقونة العين المشطوبة (مخفية وتظهر عند إظهار الكلمة) -->
                                <svg id="eyeSlashIcon" style="display: none;" xmlns="http://w3.org" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
                                    <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/>
                                    <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 rounded-3 fw-bold">إنشاء الحساب</button>
                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-decoration-none">لديك حساب بالفعل؟ تسجيل الدخول</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword() {
        var input = document.getElementById("passwordInput");
        var eye = document.getElementById("eyeIcon");
        var eyeSlash = document.getElementById("eyeSlashIcon");

        if (input.type === "password") {
            input.type = "text";
            eye.style.display = "none";
            eyeSlash.style.display = "inline";
        } else {
            input.type = "password";
            eye.style.display = "inline";
            eyeSlash.style.display = "none";
        }
    }
</script>
