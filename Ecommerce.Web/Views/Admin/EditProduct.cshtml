@model Ecommerce.Domain.Entities.Product
@{
    ViewData["Title"] = "تعديل المنتج";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container mt-5 mb-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="admin-card">
                <h3 class="admin-card-header text-center"> تعديل بيانات المنتج</h3>
                
                <form asp-action="EditProduct" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">اسم المنتج</label>
                        <input asp-for="Name" class="form-control custom-input" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">وصف المنتج</label>
                        <textarea asp-for="Description" class="form-control custom-input" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">السعر ($)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control custom-input" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">القسم</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select custom-input" required></select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary">رابط الصورة (Image URL)</label>
                        <input asp-for="ImageUrl" class="form-control custom-input" required />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning btn-lg fw-bold rounded-3">حفظ التعديلات</button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light text-secondary rounded-3 py-2">إلغاء</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

